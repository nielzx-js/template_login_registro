
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0b080b;
            color: #f4edf3;
        }

        .container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
        }

        .card {
            background: #160f15;
            border: 1px solid #2c1e2a;
            border-radius: 12px;
            padding: 35px;
        }

        h1 {
            margin-bottom: 8px;
        }

        .subtitle {
            color: #b7a8b5;
            margin-bottom: 30px;
        }

        .input-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #51404f;
            border-radius: 7px;
            background: #211720;
            color: #f4edf3;
            outline: none;
        }

        input:focus {
            border-color: #a875a0;
        }

        button {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 7px;
            background: #a875a0;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            margin-top: 5px;
        }

        button:hover {
            opacity: 0.9;
        }

        .login {
            text-align: center;
            margin-top: 22px;
            color: #b7a8b5;
            font-size: 14px;
        }

        .login a {
            color: #a875a0;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <main class="container">
        <div class="card">

            <h1>Criar conta</h1>
            <p class="subtitle">Cadastre-se para continuar</p>

            <form>

                <div class="input-group">
                    <label for="nome">Nome</label>
                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Seu nome"
                    >
                </div>

                <div class="input-group">
                    <label for="email">E-mail</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="seu@email.com"
                    >
                </div>

                <div class="input-group">
                    <label for="senha">Senha</label>
                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="••••••••"
                    >
                </div>

                <div class="input-group">
                    <label for="confirmarSenha">Confirmar senha</label>
                    <input
                        type="password"
                        id="confirmarSenha"
                        name="confirmarSenha"
                        placeholder="••••••••"
                    >
                </div>

                <button type="submit">
                    Criar conta
                </button>

            </form>

            <p class="login">
                Já possui uma conta?
                <a href="/login">Entrar</a>
            </p>

        </div>
    </main>

</body>
</html>
